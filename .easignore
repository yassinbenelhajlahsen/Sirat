*.pem
.env
*.tsbuildinfo
coverage/
.vscode
.planning/
.superpowers/
.claude/worktrees/

# --- from frontend/.gitignore ---
/frontend/ios
/frontend/android

# --- not needed to build the app ---
/screenshots/
/demos/
/docs/
/devDocs/
/backend/
/shared/
/.github/
/.claude/
/frontend/__tests__/
