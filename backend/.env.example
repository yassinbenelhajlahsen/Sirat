# Server
PORT=3001
NODE_ENV=development
TRUST_PROXY=

# CORS
FRONTEND_URL=http://localhost:8081

# OpenAI (the chat feature: answers and moderation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Chat answer speed tier. "default" (default) is the standard tier; "fast" costs 2x per token and roughly halves reply time.
OPENAI_SERVICE_TIER=default

# Chat. Off unless exactly "1"; the routes return 503 while off.
CHAT_ENABLED=0
# Long random string. Keys the monthly quota to an HMAC of the Apple/Google ID.
# Changing it resets everyone's count for the month.
CHAT_IDENTITY_SECRET=
# "text" quotes the English Quran translation; "reference" shows Arabic + reference only.
CHAT_QURAN_QUOTES=text
CHAT_SCHOLAR_LINK=https://seekersguidance.org/answers/

# Apple DeviceCheck (limits free chat quota per device)
DEVICECHECK_TEAM_ID=
DEVICECHECK_KEY_ID=
# The .p8 key on one line, with newlines written as \n
DEVICECHECK_PRIVATE_KEY=
DEVICECHECK_ENV=production
# "0" skips DeviceCheck (simulators, local dev). Never 0 in production.
DEVICECHECK_REQUIRED=1

# Google Maps (mosque search — fails without this)
GOOGLE_MAPS_API_KEY=

# Logging
LOG_LEVEL=info

# Minimum version gate
# Every request from a build below this version (or with no version header)
# gets 426 and the app shows its force-update screen. Raise it only after the
# new native build is approved and live on the App Store.
MIN_SUPPORTED_APP_VERSION=1.0.0

# Database (Postgres). Required for account & sync endpoints and Prisma.
# In production include sslmode, e.g. ...railway.../db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sirat

# Only needed for `npm run migrate:dev` if your local Postgres role cannot
# CREATE DATABASE (Prisma auto-creates a shadow DB otherwise). Not used in prod.
SHADOW_DATABASE_URL=

# Clerk (auth). Backend verifies JWTs and performs admin account deletion.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
