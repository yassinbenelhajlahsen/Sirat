# Server
PORT=3001
NODE_ENV=development
TRUST_PROXY=

# CORS
FRONTEND_URL=http://localhost:8081

# OpenAI (dua matching — falls back to random dua if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Google Maps (mosque search — fails without this)
GOOGLE_MAPS_API_KEY=

# Logging
LOG_LEVEL=info

# Minimum version gate
# Set ENFORCE_MIN_VERSION=true only after the frontend update that sends
# version headers has been shipped. Leaving it false enables monitor mode
# (logs incoming versions but never blocks requests).
MIN_SUPPORTED_APP_VERSION=1.0.0
ENFORCE_MIN_VERSION=false

# Database (Postgres). Required for account & sync endpoints and Prisma.
# In production include sslmode, e.g. ...railway.../db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sirat

# Only needed for `npm run migrate:dev` if your local Postgres role cannot
# CREATE DATABASE (Prisma auto-creates a shadow DB otherwise). Not used in prod.
SHADOW_DATABASE_URL=

# Clerk (auth). Backend verifies JWTs and performs admin account deletion.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
